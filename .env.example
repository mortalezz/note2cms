# note2cms configuration
API_TOKEN=CHANGE_ME_TO_A_REAL_TOKEN
SITE_TITLE=My Blog
SITE_URL=http://localhost:8000
SITE_LANG=en
STATIC_DIR=./static
CONTENT_DIR=./content
THEMES_DIR=./themes
ACTIVE_THEME=default
DB_PATH=./taxonomy.db

# Pagination & media
POSTS_PER_PAGE=10
PAGINATION_MODE=stable
GALLERY_AUTO=true
MAX_IMAGE_MP=1.0
MAX_ASSET_MB=15.0

# Feeds, navigation, search, CORS
FEED_FULL_TEXT=true
SEARCH=false
NAV_PAGES=
CORS_ORIGINS=*
